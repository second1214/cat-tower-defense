// Cloudflare Workers で公開するときの設定（npm run build で作った dist を配る。/api/ranking だけ worker/index.js が答える）
{
  "name": "cat-tower-defense",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // ランキングの保存先。id を書かなければ、はじめてデプロイしたときに自動で作られる
  "kv_namespaces": [{ "binding": "RANKING" }]
}
