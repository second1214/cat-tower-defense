// Cloudflare Workers で公開するときの設定（npm run build で作った dist を配る。/api/ranking だけ worker/index.js が答える）
{
  "name": "cat-tower-defense",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // ランキングの保存先（KV「cat-ranking」）
  "kv_namespaces": [{ "binding": "RANKING", "id": "a89f0704f6094facb63a8aa58ef99cd0" }]
}
